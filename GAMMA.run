import { BETA_profile } from "./BETA.set/BETA.profile.js";
import { BETA_gamma } from "./BETA.set/BETA.gamma.js";
import { BETA_run } from "./BETA.set/BETA.run.js";

export const GAMMA_run = {
  id: "GAMMA.run",
  mode: "formula",
  status: "active",

  run(alpha) {
    const normalized = BETA_profile.normalize(alpha);
    const check = BETA_gamma.check(normalized);
    const beta = BETA_run.run(alpha);

    return {
      id: "GAMMA.formula",
      relativity: this.relativity(normalized),
      geometry: this.geometry(normalized),
      math: this.math(normalized),
      iki1uc: this.iki1uc(normalized, beta),
      ready: beta.ready
    };
  },

  // Relativität (Einstein)
  relativity(alpha) {
    return {
      E: `E = m * c^2`,
      gamma: `γ = 1 / sqrt(1 - (v^2 / c^2))`,
      time_dilation: `t' = t * γ`,
      length_contraction: `L' = L * sqrt(1 - (v^2 / c^2))`,
      relativistic_mass: `m' = γ * m`,
      alpha_degree: alpha.degree
    };
  },

  // Geometrie
  geometry(alpha) {
    return {
      circle: `A = π * r^2`,
      sphere: `V = 4/3 * π * r^3`,
      triangle: `A = 1/2 * b * h`,
      cube: `V = a^3`,
      rotation: alpha.rotation,
      percent: alpha.percent
    };
  },

  // Mathe
  math(alpha) {
    return {
      linear: `f(x) = mx + b`,
      quadratic: `f(x) = ax^2 + bx + c`,
      derivative: `d/dx (x^n) = n * x^(n-1)`,
      integral: `∫ x^n dx = x^(n+1)/(n+1) + C`,
      alpha_tmp: alpha.tmp
    };
  },

  // iki1uc interne Formel
  iki1uc(alpha, beta) {
    return {
      alpha360: alpha.degree === "360°",
      alpha100: alpha.percent === "100%",
      beta_code: beta.code,
      beta_tech: beta.tech,

      mass_alpha: parseInt(alpha.degree) / 360,
      mass_beta: beta.code === "OK" ? 1 : 0,
      mass_rotation: alpha.rotation === "FULL" ? 1 : 0,

run_full(alpha) {
  const base = this.run(alpha);        // deine alte Formel-Version
  const all = ALLXALL.connect(alpha);  // neue Verbindungsschicht

  return {
    ...base,
    all
  };
}
